# Copy to the path in crew_env_file: in automation/paths.yaml (outside this repo) and fill in.
# `npm run dev` loads it.
# `npm run deploy` uploads the same values as Worker secrets (not CREW_DEV_LOGIN, the sandbox
# keys or localhost-only GitHub apps).

# Second Stripe account: the Connect platform for crew payouts.
# Live keys, used by the deployed site (uploaded by `npm run deploy`).
STRIPE_CREW_SECRET_KEY=sk_live_REPLACE_ME
# Signing secrets of the live webhook endpoints at <site>/crew/webhook, comma-separated
# (one for "Your account" events, one for "Connected accounts" events).
STRIPE_CREW_WEBHOOK_SECRET=whsec_REPLACE_ME

# Sandbox keys, used only on localhost (never the live ones there) and never uploaded.
STRIPE_CREW_SANDBOX_SECRET_KEY=sk_test_REPLACE_ME
# The whsec_ that `stripe listen` prints (see "Stripe (second account)" in README.md).
STRIPE_CREW_SANDBOX_WEBHOOK_SECRET=whsec_REPLACE_ME

# Percent of each payment kept by the site host (0 to 99). The rest goes to the crew member.
CREW_PLATFORM_FEE_PERCENT=10
CREW_CURRENCY=usd

# GitHub OAuth apps for sign-in, one per site, each with callback <site>/crew/auth/callback.
# Name each app's keys GITHUB_<NAME>_NAME (its GitHub application name), GITHUB_<NAME>_HOST
# (its hosts, comma-separated), GITHUB_<NAME>_CLIENT_ID and GITHUB_<NAME>_CLIENT_SECRET.
# Each request uses the app named for its host.
# Apps only for localhost are never uploaded.
GITHUB_EARTH_1_NAME="Model.Earth Studio"
GITHUB_EARTH_1_HOST=studio.model.earth
GITHUB_EARTH_1_CLIENT_ID=
GITHUB_EARTH_1_CLIENT_SECRET=
# Membership Databases
GITHUB_CREW_1_NAME=
GITHUB_CREW_1_NAME=
GITHUB_CREW_1_HOST=crew.dreamstudio.com
GITHUB_CREW_1_CLIENT_ID=
GITHUB_CREW_1_CLIENT_SECRET=
# Studio Square, a future organization in an ecosystem of ecosystems.
GITHUB_STUDIO_1_NAME=
GITHUB_STUDIO_1_HOST=
GITHUB_STUDIO_1_CLIENT_ID=
GITHUB_STUDIO_1_CLIENT_SECRET=
# Desktop Ports
GITHUB_LOCAL_1_NAME=
GITHUB_LOCAL_1_HOST=localhost:4201
GITHUB_LOCAL_1_CLIENT_ID=
GITHUB_LOCAL_1_CLIENT_SECRET=
# For hosts without a named app.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional token for higher GitHub API rate limits when reading issues.
GITHUB_TOKEN=

# GitHub logins (comma-separated) who accept or reject bids for this site host.
CREW_ADMIN_GITHUB_LOGINS=
# Repo owners whose issues can take bids (comma-separated). Empty allows any public repo.
CREW_GITHUB_OWNERS=ModelEarth


# Local testing only: allows /crew/dev-login?login=name on localhost without GitHub.
CREW_DEV_LOGIN=false

# ArtCraft webapp accounts. ArtCraft's API only accepts sign-ups and sign-ins from its own
# sites, so with this set, the deployed site sends sign-up, login and signed-in-only pages
# (library, media, video editor, checkout) to this ArtCraft site. The home page and the
# create- pages stay here. Leave empty once ArtCraft allows this site (see README.md).
# Localhost is never redirected; it uses the local backend.
ARTCRAFT_ACCOUNTS_URL=https://app.getartcraft.com

# Deploys (`npm run deploy`): Cloudflare account for studio.model.earth. Not uploaded as
# Worker secrets. Leave empty to use cloudflare_env_file: in automation/paths.yaml instead.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
